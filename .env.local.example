# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# Supabase → Project Settings → API
#
# Both of these are safe to expose to the browser. The anon key is public by design;
# it is Row Level Security, not secrecy, that protects student data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Deliberately NOT here yet
# ---------------------------------------------------------------------------
#
# SUPABASE_SERVICE_ROLE_KEY — bypasses RLS entirely. Do not add until a server-side
#   job genuinely needs it, and never import it into a client component.
#
# AI provider keys — the provider is chosen in Phase 3. All provider keys stay
#   server-side; students never supply their own.
#
# N8N_* credentials — orchestration layer, wired up in a later phase.
