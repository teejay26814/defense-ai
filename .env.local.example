# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# Supabase → Project Settings → API
#
# Both of these are safe to expose to the browser. The anon key is public by design;
# it is Row Level Security, not secrecy, that protects student data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where Supabase should send people back to from confirmation and password-reset emails.
# Must match a URL allowed in Supabase, Authentication, URL Configuration, or the link in
# the email is rejected when it comes back. Public on purpose: it is only an origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-side only. Never prefixed NEXT_PUBLIC_ — these must not reach the browser.
# ---------------------------------------------------------------------------

# n8n webhook URLs — the Production URL from each workflow's Webhook node.
# Each workflow must end in a "Respond to Webhook" node: these calls are synchronous, so
# the server action can write results under the student's own session.
N8N_EMBED_WEBHOOK_URL=
N8N_QUERY_WEBHOOK_URL=
N8N_ANSWER_WEBHOOK_URL=
N8N_QUESTIONS_WEBHOOK_URL=
N8N_MNEMONICS_WEBHOOK_URL=
N8N_EVALUATE_WEBHOOK_URL=

# Signs outbound requests so n8n can reject anything not from this app. Generate with:
#   openssl rand -hex 32
# The same value goes in the n8n workflow. Rotating it means updating both sides.
N8N_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Deliberately NOT here
# ---------------------------------------------------------------------------
#
# OPENROUTER_API_KEY — lives in n8n, not here. Answer generation runs in the Answer
#   workflow using n8n's OpenRouter credential, so the prompt can be reworded on the
#   canvas without redeploying this app. The model is chosen on the OpenRouter Model
#   node. Retrieved chunks are still hydrated from Postgres under the student's own
#   session before being sent, so RLS still decides what can reach the prompt.
#
# SUPABASE_SERVICE_ROLE_KEY — not needed. Because the n8n calls are synchronous, every
#   write still happens under the student's session and RLS applies throughout. Nothing
#   in this app bypasses RLS.
#
# PINECONE_API_KEY — lives in n8n, not here. n8n owns the vector index; this app never
#   talks to Pinecone directly.
#
# No embeddings key is required: the Pinecone index is created "by model" (integrated
#   inference), so Pinecone embeds text on upsert and on search.

# Paystack - Settings, API Keys in the dashboard. Secret key is server-only.
PAYSTACK_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
